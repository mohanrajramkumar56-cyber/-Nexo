{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "config.wsgi:application",
      "buildCommand": "python manage.py migrate --noinput"
    }
  },
  "redirects": [
    {
      "source": "/login",
      "destination": "/#/login",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/#/register",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/#/dashboard",
      "permanent": false
    },
    {
      "source": "/projects/:path*",
      "destination": "/#/projects/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "index.html"
      }
    }
  ]
}
